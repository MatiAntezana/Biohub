{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biohub://schemas/experiment.schema.json",
  "type": "object",
  "required": ["schema_version", "experiment_id", "entrypoint", "arguments", "allowed_nodes", "default_node", "execution_policy", "dependencies", "data_policy", "artifact_contract", "documentation", "kaggle"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{3}[A-Z]?$"},
    "entrypoint": {"type": "string", "pattern": "^[^/]+\\.py$"},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "allowed_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "default_node": {"type": "string"},
    "execution_policy": {
      "type": "object",
      "required": ["node_selection", "min_free_vram_mib", "auto_launch", "max_parallel_runs"],
      "properties": {
        "node_selection": {"enum": ["max_free_vram", "auto", "explicit"]},
        "min_free_vram_mib": {"type": "integer", "minimum": 0},
        "auto_launch": {"type": "boolean"},
        "max_parallel_runs": {"type": "integer", "minimum": 1}
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EXP-[0-9]{3}[A-Z]?$"}},
    "data_policy": {"type": "object"},
    "artifact_contract": {
      "type": "object",
      "required": ["terminal_receipt", "checkpoints", "minimum_checkpoints", "maximum_checkpoints"],
      "properties": {
        "terminal_receipt": {"type": "string"},
        "checkpoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minimum_checkpoints": {"type": "integer", "minimum": 1},
        "maximum_checkpoints": {"type": "integer", "minimum": 1}
      }
    },
    "documentation": {"type": "object"},
    "kaggle": {
      "type": "object",
      "required": ["enabled", "deployment_ready", "training_allowed", "test_only", "accelerator", "submission_columns"],
      "properties": {
        "enabled": {"type": "boolean"},
        "deployment_ready": {"type": "boolean"},
        "auto_publish_after_train": {"type": "boolean"},
        "auto_push": {"type": "boolean"},
        "auto_submit": {"type": "boolean"},
        "training_allowed": {"const": false},
        "test_only": {"const": true},
        "accelerator": {"const": "NvidiaTeslaT4"},
        "submission_columns": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}}
      }
    }
  }
}
