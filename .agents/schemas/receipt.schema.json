{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biohub://schemas/receipt.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment_id", "status", "config_sha256", "environment", "artifacts", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "status": {"enum": ["RUNNING", "SUCCEEDED", "FAILED", "ORPHANED"]},
    "config_sha256": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "artifacts": {"type": "object"},
    "metrics": {"type": "object"}
  }
}
