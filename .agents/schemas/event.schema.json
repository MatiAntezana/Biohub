{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biohub://schemas/event.schema.json",
  "type": "object",
  "required": ["schema_version", "event_id", "timestamp_utc", "experiment_id", "run_id", "event_type", "status", "previous_event_hash", "event_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 16},
    "timestamp_utc": {"type": "string"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{3}[A-Z]?$"},
    "run_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
