{
  "schema_version": 1,
  "automatic_mode_requires_attached_agent": true,
  "poll_seconds": 30,
  "heartbeat_seconds": 300,
  "report_on": [
    "run_started",
    "epoch_changed",
    "run_completed",
    "run_failed",
    "run_orphaned",
    "kaggle_state_changed",
    "kaggle_auto_published",
    "kaggle_auto_waiting",
    "kaggle_auto_blocked",
    "submission_created",
    "public_score_received",
    "variant_created",
    "policy_paused",
    "cycle_error",
    "remote_gpu_process_started",
    "remote_gpu_process_stopped",
    "remote_gpu_experiment_identified"
  ],
  "unchanged_heartbeat": true,
  "scan_all_enabled_remote_gpus": true,
  "unknown_gpu_process_policy": "notify_read_only_do_not_adopt_control",
  "keep_agent_turn_open_until": "Cortar automatico",
  "full_logs_in_chat": false,
  "codex_heartbeat": {
    "automation_id": "biohub-automatic-live-monitor",
    "interval_minutes": 10,
    "disable_on_cortar_automatico": true
  }
}
