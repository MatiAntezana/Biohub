__pycache__/
*.pyc
.DS_Store
.state/
scratch/

# Ignore heavy binaries and archives
*.whl
*.zip
*.tar*
*.npy
*.npz
*.geff
*.csv

# Ignore MLflow and secrets
mlruns*/
mlartifacts/
.env
kaggle.json

# Model weights: ignore all except the 3 canonical champion models
*.pt
*.pth
*.bin
*.safetensors
!assets/champion/**
!assets/champion/**/*.pt
!assets/champion/**/*.pth

# Artifacts: allow all experimental json receipts and evidence, ignore binary payloads
artifacts/**/raw/
artifacts/**/cache-*/
artifacts/**/visible/
artifacts/**/kaggle-output/*.csv

