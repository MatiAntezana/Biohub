{
  "schema_version": 1,
  "experiment_id": "EXP-059",
  "name": "DeepGraph Wide HighRes Anisotropic (Wide UNet 48-192 + T=4 + Z 3.5um + Downsample 1,2,2 + Cosine LR)",
  "entrypoint": "train.py",
  "arguments": [
    "--epochs",
    "50",
    "--batch-size",
    "1",
    "--num-workers",
    "2",
    "--max-iters",
    "750"
  ],
  "allowed_nodes": [
    "A1552",
    "A1555",
    "A1556",
    "A1557",
    "A1560"
  ],
  "default_node": "A1560",
  "execution_policy": {
    "node_selection": "max_free_vram",
    "min_free_vram_mib": 18000,
    "auto_launch": true,
    "max_parallel_runs": 1
  },
  "priority": 12,
  "dependencies": [],
  "data_policy": {
    "mode": "full-fit",
    "validation": "N/A — full-fit sin validación",
    "full_fit": true,
    "train_fraction": 1.0
  },
  "artifact_contract": {
    "terminal_receipt": "artifacts/{run_id}/TRAINING_COMPLETE.json",
    "checkpoints": [
      "checkpoints/{run_id}/*/training_checkpoint.pth"
    ],
    "minimum_checkpoints": 2,
    "maximum_checkpoints": 2
  },
  "documentation": {
    "narrative": "Librería-Registros/Experimentos/EXP-059_DeepGraph_Wide_HighRes_Anisotropic.md",
    "strategy": "Librería-Registros/Estrategias/Estrategia_DeepGraph_Temporal_Transformer.md"
  },
  "kaggle": {
    "enabled": true,
    "deployment_ready": true,
    "kernel_slug": "matiasantezana/biohub-exp-059-deepgraph",
    "training_allowed": false,
    "test_only": true,
    "accelerator": "NvidiaTeslaT4",
    "competition": "biohub-cell-tracking-during-development",
    "output_file": "submission.csv",
    "auto_publish_after_train": true,
    "auto_push": true,
    "auto_submit": true,
    "max_retries": 2,
    "poll_seconds": 60,
    "submission_columns": [
      "id",
      "dataset",
      "row_type",
      "node_id",
      "t",
      "z",
      "y",
      "x",
      "source_id",
      "target_id"
    ]
  }
}
